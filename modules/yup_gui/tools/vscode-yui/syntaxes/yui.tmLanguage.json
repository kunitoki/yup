{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YUI",
  "scopeName": "source.yui",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#colors" },
    { "include": "#at-rules" },
    { "include": "#declarations" },
    { "include": "#selectors" },
    { "include": "#property-names" },
    { "include": "#numbers" },
    { "include": "#members" },
    { "include": "#shapes" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.yui", "match": "//.*$" },
        { "name": "comment.block.yui", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.yui", "match": "\\\\(?:x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|.)" },
            { "name": "constant.other.placeholder.yui", "match": "%[-+ #0]*[0-9]*(?:\\.[0-9]+)?[diouxXeEfgGcs%]" }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        { "name": "constant.other.color.rgb-value.yui", "match": "#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3,4})\\b" }
      ]
    },
    "at-rules": {
      "patterns": [
        { "name": "keyword.control.at-rule.yui", "match": "@[A-Za-z][A-Za-z0-9_-]*" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(drawing|palette|component|pattern|marker|use)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.yui" },
            "2": { "name": "entity.name.type.yui" }
          }
        },
        {
          "match": "\\b(property)\\s+(?:(alias)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.yui" },
            "2": { "name": "storage.type.yui" },
            "3": { "name": "variable.other.property.yui" }
          }
        },
        {
          "match": "\\b(signal)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.yui" },
            "2": { "name": "entity.name.function.yui" }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.yui" },
            "2": { "name": "variable.other.yui" }
          }
        },
        {
          "match": "\\b(repeat)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.yui" },
            "2": { "name": "variable.other.yui" },
            "3": { "name": "keyword.control.yui" }
          }
        }
      ]
    },
    "selectors": {
      "patterns": [
        { "name": "entity.other.attribute-name.id.yui", "match": "#[A-Za-z_][A-Za-z0-9_]*(?=[^;{}()]*(?:\\{|,\\s*(?://.*)?$))" },
        { "name": "entity.other.attribute-name.class.yui", "match": "\\.[A-Za-z_][A-Za-z0-9_]*(?=[^;{}()]*(?:\\{|,\\s*(?://.*)?$))" },
        { "name": "entity.other.attribute-name.pseudo-class.yui", "match": ":[A-Za-z][A-Za-z0-9_-]*(?=[^;{}()]*(?:\\{|,\\s*(?://.*)?$))" }
      ]
    },
    "property-names": {
      "patterns": [
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*:(?![A-Za-z0-9_-]+[^;{}()]*(?:\\{|,\\s*(?://.*)?$)))",
          "captures": {
            "2": { "name": "support.type.property-name.yui meta.object-literal.key.yui" }
          }
        },
        {
          "match": "([{;])(\\s*)([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*:(?![A-Za-z0-9_-]+[^;{}()]*(?:\\{|,\\s*(?://.*)?$)))",
          "captures": {
            "3": { "name": "support.type.property-name.yui meta.object-literal.key.yui" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(\\d+(?:\\.\\d+)?)(deg|rad|grad|turn|ms|px|s|%)(?![A-Za-z0-9_])",
          "captures": {
            "1": { "name": "constant.numeric.yui" },
            "2": { "name": "keyword.other.unit.yui" }
          }
        },
        { "name": "constant.numeric.yui", "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b" }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "2": { "name": "support.function.yui" }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "variable.other.member.yui" }
          }
        }
      ]
    },
    "shapes": {
      "patterns": [
        { "name": "support.class.shape.yui", "match": "\\b(?:rect|circle|ellipse|arc|line|path|polygon|star|text|image|svg|layer|group|clipPath|clip|mask|viewport|filter|blur|offset|flood|colorMatrix|composite|blend|morphology|lighting|displacement|dropShadow)\\b(?=\\s*\\{)" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "support.function.builtin.yui", "match": "\\b(?:sin|cos|tan|asin|acos|atan2|atan|sqrt|pow|exp|log2|log10|log|abs|floor|ceil|round|trunc|sign|fmod|min|max|clamp|lerp|mix|map|smoothstep|hypot|deg|rad|len|format|rgba|rgb|hsla|hsl|polar|linearGradient|radialGradient|angularGradient|action|point|size|rect|line|path|dash|transform|color|font|cubicBezier|hue-rotate|drop-shadow)\\b(?=\\s*\\()" },
        { "name": "entity.name.function.yui", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.yui", "match": "\\b(?:import|repeat|in|changed|from|to)\\b" },
        { "name": "storage.type.yui", "match": "\\b(?:tokens|style|component|drawing|palette|pattern|marker|use|property|alias|signal|let)\\b" },
        { "name": "storage.type.primitive.yui", "match": "\\b(?:number|integer|boolean|string|color|point|rectangle|transform|font|any|bool|int|float|double)\\b" },
        { "name": "constant.language.yui", "match": "\\b(?:true|false|pi|tau)\\b" },
        { "name": "variable.language.yui", "match": "\\b(?:self|parent|root|theme)\\b" },
        { "name": "constant.other.yui", "match": "\\b[A-Z][A-Z0-9_]+\\b" },
        { "name": "entity.name.type.yui", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.binding.yui", "match": "<=>" },
        { "name": "keyword.operator.arrow.yui", "match": "=>" },
        { "name": "keyword.operator.range.yui", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.yui", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.yui", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.ternary.yui", "match": "\\?" },
        { "name": "keyword.operator.arithmetic.yui", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.yui", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.yui", "match": ";" },
        { "name": "punctuation.separator.yui", "match": "[,:]" },
        { "name": "punctuation.section.block.yui", "match": "[{}]" },
        { "name": "punctuation.section.brackets.yui", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.yui", "match": "[()]" }
      ]
    }
  }
}
