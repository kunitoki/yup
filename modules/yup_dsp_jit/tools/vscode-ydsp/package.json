{
  "name": "vscode-ydsp",
  "displayName": "YDSP - YUP DSP Language",
  "description": "Syntax highlighting, snippets and editing support for YDSP, the realtime JIT-compiled audio DSP language of the YUP library.",
  "version": "1.0.0",
  "publisher": "yup",
  "license": "ISC",
  "icon": "images/ydsp-icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ydsp",
    "yup",
    "dsp",
    "audio",
    "jit",
    "syntax"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kunitoki/yup"
  },
  "homepage": "https://github.com/kunitoki/yup",
  "contributes": {
    "configuration": {
      "title": "YDSP",
      "properties": {
        "ydsp.server.path": {
          "type": "string",
          "description": "Absolute path to a development yup_dsp_compiler binary."
        },
        "ydsp.server.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off"
        }
      }
    },
    "languages": [
      {
        "id": "ydsp",
        "aliases": [
          "YDSP",
          "ydsp"
        ],
        "extensions": [
          ".ydsp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/ydsp-icon.png",
          "dark": "./images/ydsp-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ydsp",
        "scopeName": "source.ydsp",
        "path": "./syntaxes/ydsp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ydsp",
        "path": "./snippets/ydsp.code-snippets"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
