plugins {
    alias(libs.plugins.androidApplication)
}

// Bundled resources, copied here by the native build
val yupAssetsDir = layout.buildDirectory.dir("generated/yup/assets").get().asFile

android {
    namespace = "@YUP_ANDROID_APPLICATION_NAMESPACE@"
    compileSdk = @YUP_ANDROID_COMPILE_SDK_VERSION@
    ndkVersion = "@YUP_ANDROID_NDK_VERSION@"

    defaultConfig {
        applicationId = "@YUP_ANDROID_APPLICATION_ID@"
        versionCode = @YUP_ANDROID_APPLICATION_VERSION_CODE@
        versionName = "@YUP_ANDROID_APPLICATION_VERSION@"
        minSdk = @YUP_ANDROID_MIN_SDK_VERSION@
        targetSdk = @YUP_ANDROID_TARGET_SDK_VERSION@

        ndk {
            @YUP_ANDROID_ABI@
        }

        externalNativeBuild {
            cmake {
                cppFlags += "-std=c++@YUP_ANDROID_CPP_VERSION@"
                arguments += "-DCMAKE_VERBOSE_MAKEFILE=ON"
                arguments += "-DANDROID_TOOLCHAIN=@YUP_ANDROID_TOOLCHAIN@"
                arguments += "-DANDROID_PLATFORM=@YUP_ANDROID_PLATFORM@"
                arguments += "-DANDROID_STL=@YUP_ANDROID_STL@"
                arguments += "-DANDROID_CPP_FEATURES=rtti exceptions"
                arguments += "-DANDROID_ALLOW_UNDEFINED_SYMBOLS=FALSE"
                arguments += "-DANDROID_PIE=ON"
                arguments += "-DYUP_ENABLE_VULKAN=@YUP_ENABLE_VULKAN@"
                arguments += "-DYUP_ANDROID_ASSETS_DIR=" + yupAssetsDir.invariantSeparatorsPath
            }
        }
    }

    /*signingConfigs {
        create("release") {
            storeFile = file("certs/app.keystore")
            storePassword = "app"
            keyAlias = "app"
            keyPassword = "app"
        }
    }*/

    buildTypes {
        getByName("debug") {
            isDebuggable = true
            isMinifyEnabled = false
        }

        getByName("release") {
            /*signingConfig = signingConfigs.getByName("release")*/
            isDebuggable = false
            isMinifyEnabled = false
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro"
            )
        }
    }

    sourceSets {
        getByName("main") {
            assets.srcDir(yupAssetsDir)
        }
    }

    // Audio read in pieces stays uncompressed, a compressed asset inflates again from its start on every seek back
    androidResources {
        noCompress += listOf("flac", "aif", "aiff")
    }

    externalNativeBuild {
        cmake {
            path = file("@YUP_ANDROID_APPLICATION_PATH@/CMakeLists.txt")
            version = "@YUP_ANDROID_CMAKE_VERSION@"
        }
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_1_8
        targetCompatibility = JavaVersion.VERSION_1_8
    }

    lint {
        checkReleaseBuilds = true
        abortOnError = false
    }

    packaging {
        jniLibs {
            keepDebugSymbols += "*/*/*.so"
            useLegacyPackaging = false
        }
    }

    buildFeatures {
        viewBinding = true
    }
}

// The native build produces the bundled resources, merge them after it
tasks.configureEach {
    val variant = Regex("^merge(\\w+)Assets$").matchEntire(name)?.groupValues?.get(1) ?: return@configureEach
    dependsOn(tasks.matching { it.name == "externalNativeBuild$variant" })
}

dependencies {
    /*implementation(libs.appcompat)
    implementation(libs.material)
    implementation(libs.constraintlayout)
    testImplementation(libs.junit)
    androidTestImplementation(libs.ext.junit)
    androidTestImplementation(libs.espresso.core)*/
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(17)
    }
}
