{
  "metadata_path": "thirdparty/rive_vendor_versions.json",
  "global_exclude_globs": [
    ".DS_Store",
    "**/.DS_Store",
    ".git/**",
    ".github/**",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "CMakeLists.txt",
    "**/CMakeLists.txt",
    "BUILD*",
    "WORKSPACE*",
    "Makefile.in",
    "Makefile.am",
    "meson.build",
    "meson_options.txt",
    "**/meson.build",
    "**/meson_options.txt",
    "test/**",
    "tests/**",
    "example/**",
    "examples/**",
    "docs/**",
    "doc/**",
    "benchmark/**",
    "benchmarks/**",
    "fuzz/**",
    "fuzzer/**",
    "perf/**",
    "script/**",
