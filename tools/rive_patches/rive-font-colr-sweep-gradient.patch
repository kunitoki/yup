Report the glyph space transform of COLR sweep gradient layers.

- source/text/font_hb.cpp: COLR sweep gradient layers also report their glyph space transform in radialTransform, placed at the sweep center, so renderers can draw them as angular gradients under the font transforms enclosing them

diff --git a/source/text/font_hb.cpp b/source/text/font_hb.cpp
index bf18635190af367d266106d41d4327f259b7816d..8b8f74c922fb5445f37ff09afbc8fe189daf8ebe 100644
--- a/source/text/font_hb.cpp
+++ b/source/text/font_hb.cpp
@@ -647,6 +647,7 @@ static void paint_sweep_gradient(
   layer.y0 = sc.y;
   layer.startAngle = startAngle;
   layer.endAngle = endAngle;
+  layer.radialTransform = state->glyphTransform() * rive::Mat2D::fromTranslate(cx, cy);
 
   state->layers->push_back(std::move(layer));
 }
