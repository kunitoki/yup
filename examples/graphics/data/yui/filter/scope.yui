// A live filter frequency-response display driven by the mode ComboBox and the knobs.
// FilterDisplay declares the component properties bound from the UI, while FilterScope
// paints the curve using 'clip', 'image', 'layer' + 'mask', 'svg', 'dash' and a 'transform'
// property ('badgeOffset') animated on hover by the stylesheet.
component FilterDisplay : Component {
    property mode: integer = 0;
    property cutoff: number = 0.65;
    property resonance: number = 0.3;
    property mix: number = 0.5;
    property logo: string = "../../logo.png";

    class: scope;
}

drawing FilterScope {
    property badgeOffset: transform = transform();

    let frame: bounds.reduced (0.5);
    let screen: bounds.reduced (1.5);
    let screenClip: path().addRoundedRectangle (screen, 9);

    let x0: screen.left + 12;
    let x1: max (x0 + 16.0, screen.right - 12);
    let w: max (16.0, x1 - x0);

    let topY: screen.top + 14;
    let bottomY: max (topY + 16.0, screen.bottom - 10);
    let plotH: max (16.0, bottomY - topY);

    let zeroY: topY + plotH * 0.38;
    let passY: lerp (zeroY + plotH * 0.14, zeroY, mix);
    let peakY: topY + (1.0 - resonance) * (passY - topY);
    let notchY: lerp (passY + plotH * 0.28, bottomY - 2.0, resonance);

    let fc: x0 + clamp (cutoff, 0.08, 0.92) * w;
    let bw: max (14.0, w * (0.20 - resonance * 0.12));
    let leftShoulder: max (x0, fc - bw);
    let rightShoulder: min (x1, fc + bw);
    let leftRoll: max (x0, fc - bw * 1.45);
    let rightRoll: min (x1, fc + bw * 1.45);
    let accent: enabled ? palette.accent : palette.textMuted;

    let lpCurve: path()
        .moveTo (x0, passY)
        .lineTo (leftShoulder, passY)
        .cubicTo (lerp (leftShoulder, fc, 0.55), passY, lerp (leftShoulder, fc, 0.72), peakY, fc, peakY)
        .cubicTo (lerp (fc, rightRoll, 0.28), peakY, lerp (fc, rightRoll, 0.55), bottomY, rightRoll, bottomY)
        .lineTo (x1, bottomY);

    let bpCurve: path()
        .moveTo (x0, bottomY)
        .lineTo (leftRoll, bottomY)
        .cubicTo (lerp (leftRoll, fc, 0.45), bottomY, lerp (leftRoll, fc, 0.72), peakY, fc, peakY)
        .cubicTo (lerp (fc, rightRoll, 0.28), peakY, lerp (fc, rightRoll, 0.55), bottomY, rightRoll, bottomY)
        .lineTo (x1, bottomY);

    let hpCurve: path()
        .moveTo (x0, bottomY)
        .lineTo (leftRoll, bottomY)
        .cubicTo (lerp (leftRoll, fc, 0.45), bottomY, lerp (leftRoll, fc, 0.72), peakY, fc, peakY)
        .cubicTo (lerp (fc, rightShoulder, 0.28), peakY, lerp (fc, rightShoulder, 0.45), passY, rightShoulder, passY)
        .lineTo (x1, passY);

    let notchCurve: path()
        .moveTo (x0, passY)
        .lineTo (leftShoulder, passY)
        .cubicTo (lerp (leftShoulder, fc, 0.55), passY, lerp (leftShoulder, fc, 0.80), notchY, fc, notchY)
        .cubicTo (lerp (fc, rightShoulder, 0.20), notchY, lerp (fc, rightShoulder, 0.45), passY, rightShoulder, passY)
        .lineTo (x1, passY);

    let responseCurve: mode == 1 ? bpCurve : (mode == 2 ? hpCurve : (mode == 3 ? notchCurve : lpCurve));
    let responseArea: responseCurve.lineTo (x1, bottomY).lineTo (x0, bottomY).close();

    let logoBox: rect (screen.right - 26, screen.top + 7, 18, 18);
    let logoClip: path().addRoundedRectangle (logoBox, 4);

    rect {
        id: background;
        bounds: frame;
        cornerRadius: 10;
        fillGradient: linearGradient (#23262a, frame.topLeft, #15171a, frame.bottomLeft);
        stroke: palette.outline.withAlpha (0.75);
        strokeWidth: 1;
        strokePosition: inside;
    }

    clip {
        path: screenClip;

        repeat i in 1 .. 6 {
            let gx: lerp (x0, x1, i / 6.0);
            line { from: point (gx, screen.top); to: point (gx, screen.bottom);
                   stroke: #ffffff0d; strokeWidth: 1; }
        }

        repeat j in 1 .. 3 {
            let gy: lerp (topY, bottomY, j / 3.0);
            line { from: point (screen.left, gy); to: point (screen.right, gy);
                   stroke: #ffffff0a; strokeWidth: 1; }
        }

        line { from: point (x0, zeroY); to: point (x1, zeroY);
               stroke: #ffffff1c; strokeWidth: 1; dash: dash (4, 3); }

        line { from: point (fc, topY); to: point (fc, bottomY);
               stroke: accent.withAlpha (0.24); strokeWidth: 1; dash: dash (2, 3); }

        // Passband spectrum bars masked to the active filter response area
        layer {
            opacity: enabled ? (0.35 + mix * 0.55) : 0.18;

            rect {
                bounds: screen;
                fillGradient: linearGradient (accent.withAlpha (0.52), point (0, topY),
                                              accent.withAlpha (0.05), point (0, bottomY));
            }

            repeat b in 0 .. 32 {
                let bx: x0 + b * (w / 32.0);
                rect { bounds: rect (bx, topY, max (2.0, w / 44.0), bottomY - topY);
                       fill: accent.withAlpha (0.28); }
            }

            mask {
                mode: alpha;
                path { data: responseArea; fill: #ffffff; }
            }
        }

        path {
            id: trace;
            data: responseCurve;
            stroke: accent.brighter (0.3);
            strokeWidth: 2.0;
            cap: round;
            join: round;
        }

        circle {
            id: cutoffDot;
            center: point (fc, mode == 3 ? notchY : peakY);
            radius: 3.2;
            fill: #ffffff;
            stroke: accent;
            strokeWidth: 1.4;
        }

        // Inline SVG badge shifted smoothly on hover via the 'badgeOffset' transform property
        svg {
            id: badge;
            bounds: rect (screen.left + 9, screen.top + 8, 15, 15);
            data: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M1.5 11.5 C4.5 11.5 5.5 4.5 8 4.5 C10.5 4.5 11.5 11.5 14.5 11.5' fill='none' stroke='#ffffff' stroke-width='1.8' stroke-linecap='round'/></svg>";
            fitting: scaleToFit;
            opacity: enabled ? 0.85 : 0.4;
            tint: accent.brighter (0.35);
            transform: badgeOffset;
        }

        // Raster image watermark clipped to a rounded square in the top-right corner
        image {
            id: watermark;
            source: logo;
            bounds: logoBox;
            fitting: scaleToFit;
            justification: center;
            clipPath: logoClip;
            opacity: enabled ? 0.55 : 0.25;
        }
    }
}
