// The knob of the synth plugin (examples/plugin/source/ui/SynthKnob.cpp) as a drawing: a well,
// a ring with the value arc, a modulation lane inside the ring, and a pointer dot on the edge
// of the well, or a text in the well instead of the dot. The colors come from the slider
// properties: backgroundColor (the well), trackColor (the ring), thumbColor (the value and the
// lane) and textColor (the pointer and the text).
drawing SynthKnob {
    property modulation: number = 0;    // the depth of a lane both ways from the value, 0 hides it
    property wellText: string = "";     // shown in the well instead of the pointer

    let area: bounds.reduced (2);
    let size: min (area.width, area.height);
    let c: area.center;
    let ringWidth: max (2.0, size * 0.08);
    let ringRadius: size * 0.5 - ringWidth;
    let wellRadius: ringRadius - ringWidth * 0.9;

    let a0: 135deg;
    let sweep: 270deg;
    let av: a0 + sweep * normalized;
    let accent: enabled ? thumbColor : textColor.withAlpha (0.5);
    let ink: enabled ? textColor : textColor.withAlpha (0.5);

    // The well, then the track and the value around it
    circle { id: well; center: c; radius: wellRadius; fill: backgroundColor; }

    arc { id: track; center: c; radius: ringRadius; from: a0; to: a0 + sweep;
          stroke: trackColor; strokeWidth: ringWidth; cap: round; }

    arc { id: valueArc; center: c; radius: ringRadius; from: a0; to: av;
          stroke: accent; strokeWidth: ringWidth; cap: round; visible: normalized > 0; }

    // The modulation lane, inside the ring
    arc { id: lane; center: c; radius: ringRadius - ringWidth * 1.4;
          from: a0 + sweep * clamp (normalized - modulation, 0.0, 1.0);
          to: a0 + sweep * clamp (normalized + modulation, 0.0, 1.0);
          stroke: accent.withAlpha (0.6); strokeWidth: ringWidth * 0.6; cap: round; visible: modulation > 0; }

    text { id: wellLabel; bounds: rect (0, 0, wellRadius * 2, wellRadius * 2).withCenter (c);
           text: wellText; font: defaultFont.withHeight (wellRadius * 0.62);
           fill: normalized > 0 ? ink : ink.withAlpha (0.6); visible: len (wellText) > 0; }

    // The pointer, a dot on the edge of the well
    let dotRadius: ringWidth * 0.55;
    circle { id: pointer; center: polar (c, wellRadius - dotRadius * 1.6, av); radius: dotRadius;
             fill: ink; visible: len (wellText) == 0; }
}
