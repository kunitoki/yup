/*
  A feedforward compressor: peak envelope follower with separate attack and
  release rates, a hard-knee gain computer, and makeup gain.
*/

processor Compressor {
    input stream in;
    output stream out;

    input value float threshold = -18.0 [[ name: "Threshold", min: -60.0, max: 0.0, unit: "dB", smoothing: 0.02 ]];
    input value float ratio = 4.0 [[ name: "Ratio", min: 1.0, max: 20.0, smoothing: 0.02 ]];
    input value float attack = 0.005 [[ name: "Attack", min: 0.001, max: 0.1, unit: "s" ]];
    input value float release = 0.15 [[ name: "Release", min: 0.01, max: 1.0, unit: "s" ]];
    input value float makeup = 1.0 [[ name: "Makeup", min: 1.0, max: 4.0, smoothing: 0.02 ]];

    state float env;

    process {
        float attackCoeff = 1.0 - exp (-1.0 / (attack * sampleRate));
        float releaseCoeff = 1.0 - exp (-1.0 / (release * sampleRate));

        float level = abs (in);
        float coeff = level > env ? attackCoeff : releaseCoeff;
        env = env + coeff * (level - env);

        float envDb = 20.0 * log10 (env + 1e-6);
        float gainDb = 0.0;
        if (envDb > threshold) { gainDb = (threshold - envDb) * (1.0 - 1.0 / ratio); }

        float gain = pow (10.0, gainDb / 20.0);
        out = in * gain * makeup;
    }
}
