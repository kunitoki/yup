#version 450
layout(local_size_x_id = 3, local_size_y = 4) in;
layout(constant_id = 7) const float kScale = 2.5;
layout(constant_id = 8) const int kCount = 3;
layout(std430, binding = 0) buffer Out { float v[]; } outBuf;
void main() {
    uint i = gl_GlobalInvocationID.x + gl_WorkGroupSize.x * gl_GlobalInvocationID.y;
    outBuf.v[i] = kScale * float(kCount);
}
