        </LayoutComponent>

        <!-- ============================== state machine ============================== -->
        <StateMachine name="State Machine 1" id="1:1">
            <!-- The four writes the picture makes back to the instance. The first and
                 last are scripted: "negate the current value" and "add one to the
                 current value" cannot be built from a converter on a listener read
                 context, because the converter drops the read. The middle two write
                 a literal, which is reliable, and are the shape to reach for when the
                 value being written does not depend on what is already there. -->
            <StateMachineListenerSingle targetId="0:243" listenerTypeValue="click" name="Count +1" id="1:40">
                <ScriptedListenerAction scriptAssetId="8:1" id="1:46"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:248" listenerTypeValue="click" name="Write note" id="1:42">
                <ListenerViewModelChange>
                    <BindablePropertyString propertyValue="written by the scene">
                        <DataBindContext sourcePathIds="5:1-5:10" propertyKey="635" direction="true"/>
                    </BindablePropertyString>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:253" listenerTypeValue="click" name="Status failed" id="1:43">
                <ListenerViewModelChange>
                    <BindablePropertyEnum propertyValue="6:4">
                        <DataBindContext sourcePathIds="5:1-5:8" propertyKey="637" direction="true"/>
                    </BindablePropertyEnum>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:407" listenerTypeValue="click" name="Toggle enabled" id="1:44">
                <ScriptedListenerAction scriptAssetId="8:2" id="1:47"/>
            </StateMachineListenerSingle>

            <!-- boolean: one transition per value, both authored -->
            <StateMachineLayer name="Enabled" id="1:2">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="1:10"/>
                </EntryState>
                <AnimationState x="0" y="60" animationId="1:12" id="1:10">
                    <StateTransition stateToId="1:11" duration="150">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="5:1-5:6" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
