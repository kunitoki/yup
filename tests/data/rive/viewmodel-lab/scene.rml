                                    <DataBindContext sourcePathIds="5:1-5:6" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- enum: three states, one per value, all six ways out authored -->
            <StateMachineLayer name="Status" id="1:3">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="1:20"/>
                </EntryState>
                <AnimationState x="0" y="60" animationId="1:23" id="1:20">
                    <StateTransition stateToId="1:21" duration="120">
                        <TransitionViewModelCondition>
