                        <LayoutComponentStyle flexDirectionValue="row" layoutAlignmentType="centerLeft" layoutWidthScaleType="fill" layoutHeightScaleType="hug" minHeight="22" minHeightUnitsValue="points" gapHorizontal="10" gapHorizontalUnitsValue="points" name="Row Style" id="0:426"/>
