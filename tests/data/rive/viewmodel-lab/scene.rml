                <AnimationState x="400" y="60" animationId="1:25" id="1:22">
                    <StateTransition stateToId="1:20" duration="120">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyEnum>
