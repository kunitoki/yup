            </StateMachineLayer>

            <!-- trigger: in on the fire, out on exit time -->
            <StateMachineLayer name="Ping" id="1:4">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
