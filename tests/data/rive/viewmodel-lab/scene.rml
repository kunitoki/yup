                <LayoutComponent clip="true" height="132" styleId="0:421" name="Card List Length" id="0:420">
                    <LayoutComponentStyle flexDirectionValue="column" layoutAlignmentType="topLeft" layoutWidthScaleType="fill" layoutHeightScaleType="hug" gapVertical="8" gapVerticalUnitsValue="points" paddingLeft="16" paddingRight="16" paddingTop="12" paddingBottom="12" paddingLeftUnitsValue="points" paddingRightUnitsValue="points" paddingTopUnitsValue="points" paddingBottomUnitsValue="points" cornerRadiusTL="12" cornerRadiusTR="12" cornerRadiusBL="12" cornerRadiusBR="12" name="Card Style" id="0:421"/>
