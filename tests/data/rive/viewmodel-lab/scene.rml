    <!-- ============ the row component: one artboard, data per instance ============ -->
    <!-- 560 wide, 12 of padding a side, so 536 of content: 120 + 220 + 90 + 20 + gaps. -->
    <Artboard x="980" y="0" defaultStateMachineId="2:1" viewModelId="5:40" viewModelInstanceId="5:41" isComponent="true" artboardKind="1" clip="true" width="320" height="44" styleId="0:52" name="Row" id="0:50">
        <Fill name="Background">
            <SolidColor colorValue="FF1F242E" name="Color"/>
        </Fill>
        <LayoutComponentStyle flexDirectionValue="row" layoutAlignmentType="centerLeft" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" gapHorizontal="12" gapHorizontalUnitsValue="points" paddingLeft="12" paddingRight="12" paddingLeftUnitsValue="points" paddingRightUnitsValue="points" cornerRadiusTL="8" cornerRadiusTR="8" cornerRadiusBL="8" cornerRadiusBR="8" name="Row Style" id="0:52"/>
        <!-- Texts here are wrapped in fixed boxes so they get a slot. A nested
             `LayoutParticipant` does the same job in one element instead of two
             -- that is what the Lab artboard above uses -- but either way a bare
             Text draws at its parent's origin and stacks on its siblings. -->
        <LayoutComponent clip="false" height="18" styleId="0:71" name="Label Box" id="0:70">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed" minWidth="64" minWidthUnitsValue="points" name="Label Box Style" id="0:71"/>
            <Text width="120" height="18" sizingValue="fixed" name="Label" id="0:51">
                <TextStylePaint fontSize="13" fontAssetId="7:3" familyName="Karla" name="Label Paint" id="0:53">
                    <Fill name="Fill">
                        <SolidColor colorValue="FFE6E9EF" name="Color"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:53" text="name" name="Run" id="0:54">
                    <DataBindContext sourcePathIds="5:40-5:45" propertyKey="268"/>
                </TextValueRun>
            </Text>
        </LayoutComponent>
        <LayoutComponent clip="true" height="8" styleId="0:56" name="Index Track" id="0:55">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed" minWidth="48" minWidthUnitsValue="points" cornerRadiusTL="4" cornerRadiusTR="4" cornerRadiusBL="4" cornerRadiusBR="4" name="Index Track Style" id="0:56"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF232936" name="Color"/>
            </Fill>
            <!-- The per-row bar: the row's `index` (itemIndex) through
                 DataConverterEnumToUint-style mapping -- here a RangeMapper 0..4 ->
                 24..200. `minWidth` matters: a bind whose source resolves to
                 nothing writes 0, and a zero-width bar draws as nothing at all, so
                 the floor keeps the bar visible and the failure legible. That is
                 what happens here: `--data-dump` shows each row's `index` as 0, 1
                 and 2, but a bind off it *inside this artboard* still resolves to
                 nothing, so all three rows draw the 24px floor. Worth knowing
                 before you trust `itemIndex` in a row. -->
            <LayoutComponent clip="true" width="24" height="8" styleId="0:58" name="Index Bar" id="0:57">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" minWidth="24" minWidthUnitsValue="points" positionTypeValue="absolute" positionLeftUnitsValue="points" positionTopUnitsValue="points" positionLeft="0" positionTop="0" cornerRadiusTL="4" cornerRadiusTR="4" cornerRadiusBL="4" cornerRadiusBR="4" name="Index Bar Style" id="0:58"/>
                <DataBindContext sourcePathIds="5:40-5:48" propertyKey="7" converterId="6:20"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FF7FB4FF" name="Color"/>
                </Fill>
            </LayoutComponent>
        </LayoutComponent>
        <LayoutComponent clip="false" height="18" styleId="0:73" name="Amount Box" id="0:72">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed" minWidth="56" minWidthUnitsValue="points" name="Amount Box Style" id="0:73"/>
            <Text width="90" height="18" sizingValue="fixed" alignValue="right" name="Amount" id="0:59">
                <TextStylePaint fontSize="13" fontAssetId="7:3" familyName="Karla" name="Amount Paint" id="0:60">
                    <Fill name="Fill">
                        <SolidColor colorValue="FF8A93A5" name="Color"/>
                    </Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:60" text="0.00" name="Run" id="0:61">
                    <DataBindContext sourcePathIds="5:40-5:46" propertyKey="268" converterId="6:14"/>
                </TextValueRun>
            </Text>
        </LayoutComponent>
        <LayoutComponent clip="true" width="20" height="20" styleId="0:63" name="Done Badge" id="0:62">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" cornerRadiusTL="10" cornerRadiusTR="10" cornerRadiusBL="10" cornerRadiusBR="10" name="Badge Style" id="0:63"/>
            <Fill name="Fill">
