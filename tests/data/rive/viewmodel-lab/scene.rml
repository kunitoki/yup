            </Fill>
        </LayoutComponent>

        <StateMachine name="State Machine 1" id="2:1">
            <StateMachineLayer name="Done" id="2:2">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
